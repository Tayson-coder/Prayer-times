<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/cat_location">
        <Preference app:key="use_gps" app:title="@string/use_gps" />
        <ListPreference app:key="city" app:title="@string/city" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="lat" app:title="@string/lat" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="lng" app:title="@string/lng" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_method">
        <ListPreference app:key="method" app:title="@string/method" app:defaultValue="egypt" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="asr" app:title="@string/asr" app:defaultValue="standard"
            app:entries="@array/asr_entries" app:entryValues="@array/asr_values" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_azan">
        <ListPreference app:key="muezzin" app:title="@string/muezzin" app:defaultValue="abdulbasit" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="fajr_muezzin" app:title="@string/fajr_muezzin" app:defaultValue="malekfajr" app:useSimpleSummaryProvider="true" />
        <Preference app:key="manage_audio" app:title="@string/manage_audio" />
        <SeekBarPreference app:key="volume" app:title="@string/volume" app:defaultValue="90" android:max="100" app:showSeekBarValue="true" />
        <SwitchPreferenceCompat app:key="enabled_fajr" app:title="@string/enable_fajr" app:defaultValue="true" />
        <SwitchPreferenceCompat app:key="enabled_dhuhr" app:title="@string/enable_dhuhr" app:defaultValue="true" />
        <SwitchPreferenceCompat app:key="enabled_asr" app:title="@string/enable_asr" app:defaultValue="true" />
        <SwitchPreferenceCompat app:key="enabled_maghrib" app:title="@string/enable_maghrib" app:defaultValue="true" />
        <SwitchPreferenceCompat app:key="enabled_isha" app:title="@string/enable_isha" app:defaultValue="true" />
        <Preference app:key="test_azan" app:title="@string/test_azan" app:summary="@string/test_azan_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_adjust">
        <EditTextPreference app:key="adjust_fajr" app:title="الفجر" app:defaultValue="0" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="adjust_sunrise" app:title="الشروق" app:defaultValue="0" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="adjust_dhuhr" app:title="الظهر" app:defaultValue="0" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="adjust_asr" app:title="العصر" app:defaultValue="0" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="adjust_maghrib" app:title="المغرب" app:defaultValue="0" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="adjust_isha" app:title="العشاء" app:defaultValue="0" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_reliability">
        <Preference app:key="exact_alarm" app:title="@string/exact_alarm" />
        <Preference app:key="battery" app:title="@string/battery" app:summary="@string/battery_summary" />
    </PreferenceCategory>
</PreferenceScreen>
