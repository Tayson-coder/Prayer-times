<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/cat_reminders">
        <SwitchPreferenceCompat app:key="remind_morning" app:title="@string/remind_morning" app:defaultValue="true" />
        <Preference app:key="morning_time" app:title="@string/morning_time" app:dependency="remind_morning" />
        <SwitchPreferenceCompat app:key="remind_evening" app:title="@string/remind_evening" app:defaultValue="true" />
        <Preference app:key="evening_time" app:title="@string/evening_time" app:dependency="remind_evening" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_dhikr">
        <SwitchPreferenceCompat app:key="dhikr_notifications" app:title="@string/dhikr_notifications" app:defaultValue="true"
            app:summaryOn="@string/dhikr_on" app:summaryOff="@string/dhikr_off" />
        <ListPreference app:key="dhikr_interval" app:title="@string/dhikr_interval" app:defaultValue="2"
            app:dependency="dhikr_notifications" app:entries="@array/dhikr_interval_entries"
            app:entryValues="@array/dhikr_interval_values" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_reading">
        <ListPreference app:key="text_size" app:title="@string/text_size" app:defaultValue="medium"
            app:entries="@array/text_size_entries" app:entryValues="@array/text_size_values" app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat app:key="vibrate" app:title="@string/vibrate" app:defaultValue="true" />
        <SwitchPreferenceCompat app:key="auto_advance" app:title="@string/auto_advance" app:summary="@string/auto_advance_summary" app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_about">
        <Preference app:key="about_source" app:title="@string/about_source" app:summary="@string/about_source_summary" app:selectable="false" />
        <Preference app:key="about_fonts" app:title="@string/about_fonts" app:summary="@string/about_fonts_summary" app:selectable="false" />
    </PreferenceCategory>
</PreferenceScreen>
