<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape><solid android:color="@color/active" /><corners android:radius="99dp" /></shape>
    </item>
    <item><shape><stroke android:width="1dp" android:color="@color/line" android:dashWidth="3dp" android:dashGap="2dp" /><corners android:radius="99dp" /></shape></item>
</selector>
