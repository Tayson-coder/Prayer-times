<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Azkar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/card</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryContainer">@color/card</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/parchment_top</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/card</item>
        <item name="colorOutline">@color/card_stroke</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:windowBackground">@color/parchment_top</item>
        <item name="android:statusBarColor">@color/parchment_top</item>
        <item name="android:navigationBarColor">@color/parchment_bottom</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <!-- android:fontFamily فقط حتى لا يغلب على الخط المحدد لكل عنصر -->
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="textAppearanceTitleLarge">@style/Text.Title</item>
        <item name="textAppearanceTitleMedium">@style/Text.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/Text.Body</item>
        <item name="textAppearanceBodyMedium">@style/Text.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/Text.Label</item>
        <item name="android:textAppearanceListItem">@style/Text.Body</item>
        <item name="android:textAppearanceListItemSecondary">@style/Text.BodyMedium</item>
        <item name="toolbarStyle">@style/Toolbar</item>
    </style>

    <style name="Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/Text.ToolbarTitle</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="Text.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/scheherazade_bold</item>
        <item name="android:fontFamily">@font/scheherazade_bold</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/scheherazade_bold</item>
        <item name="android:fontFamily">@font/scheherazade_bold</item>
    </style>
    <style name="Text.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/plex_medium</item>
        <item name="android:fontFamily">@font/plex_medium</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/plex_regular</item>
        <item name="android:fontFamily">@font/plex_regular</item>
    </style>
    <style name="Text.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/plex_regular</item>
        <item name="android:fontFamily">@font/plex_regular</item>
    </style>
    <style name="Text.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/plex_medium</item>
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- أزرار الشريط السفلي: مربع بزوايا مستديرة ودائرة، بحد بني كما في التصميم -->
    <style name="ControlSquare">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/btn_square</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/control</item>
    </style>
    <style name="ControlCircle">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/btn_circle</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/control</item>
    </style>
</resources>
